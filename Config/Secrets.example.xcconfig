// Template for your local Secrets.xcconfig — use YOUR OWN newsapi.org key.
//
// 1. Get a free key: https://newsapi.org/register
// 2. Copy this file next to itself (the copy is git-ignored and never committed):
//      cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// 3. In Secrets.xcconfig paste the key after "=", without quotes:
//      NEWS_API_KEY = 0123456789abcdef0123456789abcdef
//
// Left empty, the app logs "NewsAPI key is missing" and shows no news.

NEWS_API_KEY =
